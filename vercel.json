{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/mandat-recherche",
      "destination": "/acheter",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap-biens.xml",
      "destination": "https://emilio-immo-chasseimmo.vercel.app/api/flux-site/sitemap"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/spa"
    }
  ],
  "headers": [
    {
      "source": "/sitemap-biens.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    }
  ]
}
